# Amharic Document AI - environment template.
#
# Copy to .env and fill in. NO VALUE HERE IS REAL and none is usable as-is:
# ADAI_SECRET_KEY is a placeholder that the application will reject at startup
# unless you replace it (control C-35).
#
# Generate a real key with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- core -------------------------------------------------------------------
# One of: dev | test | staging | prod. Interactive API docs are served only in dev.
ADAI_ENVIRONMENT=dev
# Verbose errors and SQL echo. Never true outside dev: bound SQL parameters can
# contain personal data (threat T-19).
ADAI_DEBUG=false

# --- secrets (never commit real values) -------------------------------------
# Session and CSRF signing key. Minimum 32 characters; startup fails below that.
ADAI_SECRET_KEY=replace-me-with-at-least-32-random-characters
# Self-hosted Postgres (Q-4: no database key ever reaches the browser).
ADAI_DATABASE_URL=postgresql+psycopg://adai_app:CHANGE_ME@postgres:5432/adai
# The worker connects as a role with BYPASSRLS (control C-18). See scripts/db_roles.sql.
# Leave unset in single-role development and it falls back to ADAI_DATABASE_URL.
ADAI_WORKER_DATABASE_URL=postgresql+psycopg://adai_worker:CHANGE_ME@postgres:5432/adai
ADAI_REDIS_URL=redis://redis:6379/0

# --- transport and CORS (controls C-01..C-04) -------------------------------
# Redirect plain HTTP and emit HSTS. Set false only for local plain-HTTP dev.
ADAI_FORCE_HTTPS=true
# HSTS max-age in seconds. Two years. Do NOT submit to the preload list until the
# domain is stable - preload is effectively irreversible.
ADAI_HSTS_MAX_AGE=63072000
# Explicit origin allowlist, comma separated. A wildcard is rejected at startup.
# Leave empty to disable cross-origin requests entirely.
ADAI_CORS_ALLOW_ORIGINS=

# --- uploads (controls C-27, C-28) ------------------------------------------
ADAI_MAX_UPLOAD_BYTES=15728640
ADAI_MAX_IMAGE_PIXELS=40000000
ADAI_MAX_IMAGE_DIMENSION=12000
# Content-type allowlist, enforced by magic bytes rather than extension. SVG is
# refused unconditionally and cannot be enabled here.
ADAI_ALLOWED_UPLOAD_TYPES=image/jpeg,image/png,image/webp
# Blob storage root. MUST be outside any web-served directory (control C-30).
ADAI_BLOB_ROOT=/var/lib/adai/blobs

# --- retention (Q-5) --------------------------------------------------------
# Original uploads are purged after this many days. Derived, redacted
# transcriptions carrying research consent are retained indefinitely.
ADAI_ORIGINAL_RETENTION_DAYS=90

# --- AI (controls C-31..C-33; provider per Q-3) -----------------------------
# OpenAI key. Server-side only - it must never reach the browser bundle.
ADAI_OPENAI_API_KEY=
# LLM post-correction. OFF by default: an LM that "improves" a transcription can
# silently rewrite a grade into something more probable but false (ADR-0009).
ADAI_LLM_POSTCORRECTION_ENABLED=false
# Global daily spend circuit breaker, USD. Fails CLOSED when exceeded.
ADAI_LLM_DAILY_SPEND_CAP_USD=5.0
ADAI_LLM_MAX_TOKENS_PER_REQUEST=2000
ADAI_USER_DAILY_JOB_QUOTA=50

# --- pipeline ---------------------------------------------------------------
# stub | full. "full" requires the ml extra and trained weights, neither of which
# ships with this repository. See docs/STATUS.md.
ADAI_PIPELINE_MODE=stub

# --- compose only -----------------------------------------------------------
POSTGRES_USER=adai_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=adai
