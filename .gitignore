# Secrets - never commit
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node
node_modules/
.next/
out/
npm-debug.log*

# Data and models - never commit a dataset or a checkpoint
data/
!data/.gitkeep
models/
*.safetensors
*.onnx
*.pt
*.pth
*.ckpt

# Artefacts
sbom.json
blobs/

# Next.js generated files
frontend/next-env.d.ts
*.tsbuildinfo
